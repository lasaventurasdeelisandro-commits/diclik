{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build && esbuild deploy/vercel-api.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/vercel-api.cjs",
  "outputDirectory": "dist/web",
  "functions": {
    "api/index.cjs": {
      "includeFiles": "src/server/db/migrations/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__diclik_api_path=:path*"
    }
  ]
}
